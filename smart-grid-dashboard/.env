# GridMind — React environment variables
# Edit this file to point at a different broker without touching any source code.
# After editing, restart "npm start" for changes to take effect.

# Local Mosquitto broker, reached via the websocket bridge on port 9001
# (see mosquitto-ws-bridge.conf at the project root — it mirrors the
# home1/... topics from the main broker on 1883).
REACT_APP_MQTT_URL=ws://localhost:9001/mqtt
REACT_APP_BROKER_LABEL=local mosquitto

# Optional auth (leave blank — local broker allows anonymous)
REACT_APP_MQTT_USERNAME=
REACT_APP_MQTT_PASSWORD=

# Chart history depth: ~15 min of data at virtual_house.py's 2s publish cadence
REACT_APP_HISTORY_MAX=450
