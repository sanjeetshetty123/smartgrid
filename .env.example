# Copy to your shell/profile (or a local .env loaded by your own tooling) —
# never commit real values here.

# Groq API key for ai_brain.py / ai_agent.py (https://console.groq.com -> API Keys)
GROQ_API_KEY=

# Telegram bot for backend.py / test_telegram.py (token from @BotFather,
# chat id from @userinfobot). TELEGRAM_CHAT_IDS accepts a comma-separated list.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_IDS=
