# GridMind — Environment Variables Example
# Copy to .env and configure your keys. Never commit real credentials to Git.

# Groq API key for ai_brain.py / ai_agent.py (https://console.groq.com -> API Keys)
GROQ_API_KEY=

# Twilio Voice Call Alerting (replacing Telegram)
# Get credentials from your Twilio Console (https://console.twilio.com)
TWILIO_ACCOUNT_SID=AC86d18a00ece430acd64bbf0bb66fa96b
TWILIO_AUTH_TOKEN=6e16975d0fb2ec5a7476a26272407cfe
TWILIO_PHONE_NUMBER=+16318007291

# Destination phone number to receive emergency voice alert calls
# Must be in E.164 format (e.g. +91XXXXXXXXXX). Multiple numbers can be comma-separated.
TWILIO_TO_PHONE_NUMBER=
